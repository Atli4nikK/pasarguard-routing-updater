# routing-updater: настройки. Права 0600 — внутри пароль админа панели.

# --- Панель PasarGuard ---
# Адрес API панели (без слеша в конце). На самой панели: http://127.0.0.1:8000
PASARGUARD_URL=https://panel.example.com
# Админ с правами settings: read/update и client_templates: read
PASARGUARD_USERNAME=admin
PASARGUARD_PASSWORD=change-me
# false — не проверять TLS-сертификат панели (самоподписанный)
PASARGUARD_VERIFY_TLS=true

# --- Профиль ---
# JSON routing-профиля Happ/INCY (DNS, DirectSites/ProxySites/BlockSites, ...). LastUpdated не нужен.
RU_TEMPLATE=/etc/pasarguard-routing-updater/template.json
# Куда писать routing.json, geosite.dat, geoip.dat, *.sha256, backup и состояние
RU_OUTPUT_DIR=/var/lib/pasarguard-routing-updater
# Клиенты, чьи правила подписки обновлять: happ incy fixerrorvpn
RU_CLIENTS=happ incy
# Создавать правило клиента над catch-all, если своего нет (fixerrorvpn — никогда)
RU_CREATE_MISSING_RULES=true

# --- Зеркало и сборка баз ---
# Публичный адрес каталога RU_OUTPUT_DIR (nginx, домен подписки), без слеша в конце.
# Пусто — базы не собираются, клиенты качают по ссылкам из шаблона, autorouting выключен.
RU_PUBLIC_BASE=https://sub.example.com/routing
# Источники баз через пробел; первый — основной. Одноимённые категории сливаются, так что
# категорию, которой нет в основной базе, можно взять из дополнительной.
RU_GEOSITE_SOURCES=https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat
RU_GEOIP_SOURCES=https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat
# Добавить в базы категории из Xray JSON-шаблонов клиентов панели (клиент разбирает их по этим же базам)
RU_SCAN_CLIENT_TEMPLATES=true
# Дополнительные категории (через пробел), например используемые в других местах
RU_EXTRA_GEOSITE=
RU_EXTRA_GEOIP=
# Заголовок autorouting для INCY (нужен RU_PUBLIC_BASE):
#   false — только routing (разовый импорт профиля при обновлении подписки);
#   only  — INCY только autorouting (профиль по ссылке с автообновлением, onadd — активируется), Happ — routing;
#   true  — оба заголовка (INCY показывал два профиля — не рекомендуется).
RU_AUTOROUTING=false

# --- Прочее ---
RU_TIMEOUT=60
RU_KEEP_BACKUPS=20
